# rc2_joystick.py: lets the logged-in user use the RC 2 and /dev/uinput.
# Has to sort before 73-seat-late.rules or the uaccess tag does nothing.

# DJI RC 2, once booted
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2ca3", ATTR{idProduct}=="1021", TAG+="uaccess"

# /dev/uinput (same rule Steam uses)
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
